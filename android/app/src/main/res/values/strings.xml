    <string name="faq_who">Qui sommes-nous ?</string>
    <string name="faq_company_desc"><![CDATA[Cette application est éditée et maintenue par Okitakoy Corp, une entreprise innovante créée par Précieux Okitakoy. Okitakoy Corp s\'engage à offrir la meilleure expérience de lecture de manga, en respectant la culture otaku et en facilitant l\'accès aux œuvres via des sources ouvertes.]]></string>
    <string name="faq_title">FAQ</string>
    <string name="faq_sources_q">Comment ajouter des sources ?</string>
    <string name="faq_sources_a"><![CDATA[Rendez-vous dans Paramètres > Sources, vous pouvez activer/désactiver les sources intégrées ou en ajouter manuellement via une URL JSON.]]></string>
    <string name="faq_sync_q">Mes données sont-elles synchronisées entre appareils ?</string>
    <string name="faq_sync_a"><![CDATA[Oui, grâce à notre serveur de synchronisation optionnel (auto-hébergé ou public). Activez la synchronisation dans les paramètres.]]></string>
    <string name="faq_free_q">L\'application est-elle gratuite ?</string>
    <string name="faq_free_a"><![CDATA[Oui, Yomi est totalement gratuite, sans publicité, et le restera toujours.]]></string>
    <string name="faq_contrib_q">Puis-je contribuer au projet ?</string>
    <string name="faq_contrib_a"><![CDATA[Bien sûr ! Le code est open source (licence GPL v3). Consultez notre dépôt GitHub.]]></string>
    <string name="credits">Crédits</string>
    <string name="credits_desc"><![CDATA[Yomi est un fork personnalisé inspiré du projet Kotatsu et de son fork Kotatsu-Redo. Nous remercions les contributeurs originaux pour leur travail exceptionnel.]]></string>
    <string name="credits_company"><![CDATA[Entité responsable : Okitakoy Corp\nCréateur : Précieux Okitakoy\nLicence : GPL v3]]></string>
